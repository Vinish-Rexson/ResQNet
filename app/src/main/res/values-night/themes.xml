<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Night variant: same B&W colours, DayNight parent ensures attrs are defined -->
    <style name="Theme.ResQNet" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/resq_primary</item>
        <item name="colorPrimaryVariant">@color/resq_primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/resq_primary</item>
        <item name="colorSecondaryVariant">@color/resq_primary</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:colorBackground">@color/surface_card</item>
        <item name="colorSurface">@color/surface_card</item>
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o">true</item>
        <item name="elevationOverlayEnabled">false</item>
        <item name="bottomNavigationStyle">@style/Widget.ResQNet.BottomNavigationView</item>
        <item name="materialButtonStyle">@style/Widget.ResQNet.Button</item>
    </style>

    <style name="Widget.ResQNet.BottomNavigationView" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="android:background">@color/white</item>
        <item name="backgroundTint">@color/white</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Widget.ResQNet.Button" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/resq_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">24dp</item>
    </style>
</resources>
