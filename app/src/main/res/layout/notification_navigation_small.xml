<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="4dp"
    android:paddingVertical="6dp">

    <!-- Maneuver Turn Arrow on Left -->
    <ImageView
        android:id="@+id/notifArrow"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@drawable/ic_notif_arrow_straight"
        android:contentDescription="Maneuver Arrow" />

    <!-- Maneuver Text & ETA -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="6dp">

        <TextView
            android:id="@+id/notifInstruction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Turn guidance"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/notifEta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Navigating with ResQNet"
            android:textColor="#9AA0A6"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end" />

    </LinearLayout>

    <ImageView
        android:id="@+id/notifIcon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_notif_pin"
        android:visibility="gone"
        android:contentDescription="Navigation" />

</LinearLayout>
