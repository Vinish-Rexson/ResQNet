<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:background="@color/surface">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true"
        android:background="@color/surface"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/surface"
            app:title="Navigate"
            app:titleTextColor="@color/text_primary"
            app:navigationIcon="@null"
            app:popupTheme="@style/ThemeOverlay.ResQNet.Popup" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/color_divider" />

    </com.google.android.material.appbar.AppBarLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <org.maplibre.android.maps.MapView
            android:id="@+id/mapView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Top status / pack card -->
        <LinearLayout
            android:id="@+id/topPackCardContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:orientation="vertical"
            android:padding="12dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/surface_card"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/color_divider">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <TextView
                        android:id="@+id/packStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp"
                        android:text="No offline region installed"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Ultra-compact Google Maps-style PiP Navigation Banner -->
        <LinearLayout
            android:id="@+id/pipNavigationBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone"
            android:background="@drawable/bg_pip_navigation_banner"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:elevation="6dp">

            <ImageView
                android:id="@+id/pipManeuverIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_notif_arrow_straight"
                app:tint="#FFFFFF"
                android:contentDescription="Maneuver" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="8dp">

                <TextView
                    android:id="@+id/pipDistanceText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Turn guidance"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/pipInstructionText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Continue on route"
                    android:textColor="#E8F5E9"
                    android:textSize="11sp"
                    android:maxLines="1"
                    android:ellipsize="end" />

            </LinearLayout>

            <TextView
                android:id="@+id/pipEtaText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:text="" />
        </LinearLayout>

        <!-- Nearest button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/nearestShelterButton"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="70dp"
            android:layout_marginEnd="16dp"
            android:backgroundTint="@color/surface_card"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:icon="@drawable/ic_search"
            android:text="Nearest"
            android:textAllCaps="false"
            app:cornerRadius="10dp"
            app:strokeColor="@color/color_divider"
            android:textColor="@color/text_primary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/reportHazardButton"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_gravity="top|start"
            android:layout_marginTop="70dp"
            android:layout_marginStart="16dp"
            android:backgroundTint="@color/surface_card"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Report"
            android:textAllCaps="false"
            app:cornerRadius="10dp"
            app:strokeColor="@color/color_divider"
            android:textColor="@color/text_primary" />

        <!-- Shelters button — square, below Nearest -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/sheltersButton"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="122dp"
            android:layout_marginEnd="16dp"
            android:backgroundTint="@color/resq_primary"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:visibility="gone"
            android:contentDescription="View nearby shelters"
            android:elevation="4dp"
            app:cornerRadius="10dp"
            app:strokeWidth="0dp"
            app:icon="@drawable/ic_shelters"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconTint="@color/white" />

        <!-- Map attribution -->
        <TextView
            android:id="@+id/mapAttribution"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="12dp"
            android:layout_marginBottom="188dp"
            android:background="@color/surface_card"
            android:paddingHorizontal="6dp"
            android:paddingVertical="3dp"
            android:text="© OpenStreetMap contributors"
            android:textColor="@color/text_muted"
            android:textSize="11sp" />

        <!-- Right-side vertical button stack: Zoom Fit / Clear Pins / My Location -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="204dp"
            android:orientation="vertical"
            android:elevation="4dp">

            <!-- Zoom to fit route -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/zoomFitButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:visibility="gone"
                android:backgroundTint="@color/surface_card"
                android:contentDescription="Zoom to fit route"
                app:cornerRadius="10dp"
                app:strokeColor="@color/color_divider"
                app:icon="@drawable/ic_zoom_fit"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconTint="@color/text_primary" />

            <Space
                android:layout_width="44dp"
                android:layout_height="8dp" />

            <!-- Clear pins -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/clearPinsButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:backgroundTint="@color/surface_card"
                android:contentDescription="Clear all pinned markers"
                app:cornerRadius="10dp"
                app:strokeColor="@color/color_divider"
                app:icon="@drawable/ic_clear_pins"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconTint="@color/text_primary" />

            <Space
                android:layout_width="44dp"
                android:layout_height="8dp" />

            <!-- My location -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/myLocationButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:backgroundTint="@color/surface_card"
                android:contentDescription="Use my current location"
                app:cornerRadius="10dp"
                app:strokeColor="@color/color_divider"
                app:icon="@drawable/ic_my_location"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconTint="@color/text_primary" />

        </LinearLayout>

        <!-- Bottom Route / Shelter Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/bottomRouteCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_margin="12dp"
            app:cardBackgroundColor="@color/surface_card"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/color_divider">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/routeSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Choose a shelter or long-press the map to preview a route."
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/shelterList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/text_muted"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/startNavigationButton"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:enabled="false"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="Start"
                        android:textAllCaps="false"
                        android:textStyle="bold"
                        app:cornerRadius="10dp"
                        app:backgroundTint="@color/resq_primary"
                        android:textColor="@color/white" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/mapManagementActions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/importPackButton"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="Import map"
                        android:textColor="@color/text_muted" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/downloadPackButton"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="Download map"
                        android:textColor="@color/text_muted" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </FrameLayout>

    <!-- Bottom Nav Divider -->
    <View
        android:id="@+id/bottomNavDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/color_divider" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bottom_nav_bg"
        app:backgroundTint="@color/bottom_nav_bg"
        app:elevation="8dp"
        app:itemIconTint="@color/bottom_nav_color"
        app:itemTextColor="@color/bottom_nav_color"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav_menu" />
</LinearLayout>
