<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_rounded"
    android:padding="24dp">

    <!-- Header Icon + Title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="14dp">

        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_card_rounded"
            android:backgroundTint="#26F04444"
            android:layout_marginEnd="14dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_mesh"
                app:tint="@color/color_logout_red" />
        </FrameLayout>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Stop Mesh Network"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />
    </LinearLayout>

    <!-- Message Body -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Slide the button below to confirm stopping the mesh. Your phone will stop relaying messages to nearby peers."
        android:textSize="14sp"
        android:textColor="@color/text_muted"
        android:lineSpacingMultiplier="1.3" />

    <!-- Slide to Stop Button -->
    <com.resqnet.app.ui.SlideButton
        android:id="@+id/stopMeshSlideButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="22dp"
        android:layout_marginBottom="12dp" />

    <!-- Cancel Text Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCancelStop"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="Cancel"
        android:textColor="@color/text_muted"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>
