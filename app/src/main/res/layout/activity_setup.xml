<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:fillViewport="true"
    android:background="@color/surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="20dp"
        android:paddingBottom="24dp">

        <!-- Logo -->
        <ImageView
            android:layout_width="140dp"
            android:layout_height="50dp"
            android:src="@drawable/ic_resqnet_logo"
            android:scaleType="fitStart"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            android:contentDescription="ResQNet Logo" />

        <!-- Top Header Text -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Welcome to ResQNet"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:fontFamily="sans-serif" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Stay connected when infrastructure disappears."
            android:textSize="14sp"
            android:textColor="@color/text_muted"
            android:layout_marginTop="4dp"
            android:lineSpacingMultiplier="1.3" />

        <!-- Header Landscape Illustration -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:src="@drawable/illustration_onboarding_header"
            android:scaleType="centerCrop"
            android:layout_marginTop="14dp"
            android:contentDescription="Onboarding landscape illustration" />

        <!-- Form Card Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_rounded"
            android:padding="20dp"
            android:layout_marginTop="12dp">

            <!-- Section 1: Display Name -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Set your display name"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <EditText
                    android:id="@+id/displayName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input_box"
                    android:hint="Alex"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_muted"
                    android:textSize="15sp"
                    android:inputType="textPersonName"
                    android:maxLength="32"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp" />

                <TextView
                    android:id="@+id/nameCounter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="14dp"
                    android:text="0/32"
                    android:textSize="12sp"
                    android:textColor="@color/text_muted" />
            </RelativeLayout>

            <!-- Section 2: Cryptographic Fingerprint -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your cryptographic fingerprint"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginTop="20dp" />

            <!-- Fingerprint Box with Copy Button -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_fingerprint_container"
                android:paddingStart="14dp"
                android:paddingEnd="8dp"
                android:paddingVertical="10dp"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/fingerprint"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <ImageButton
                    android:id="@+id/btnCopyFingerprint"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_content_copy"
                    android:contentDescription="Copy fingerprint"
                    app:tint="@color/text_primary" />
            </LinearLayout>

            <!-- Explanation Caption -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="This identifies this app installation. It does not verify your real-world identity."
                android:textSize="12sp"
                android:textColor="@color/text_muted"
                android:layout_marginTop="8dp"
                android:lineSpacingMultiplier="1.3" />

        </LinearLayout>

        <!-- Enter Local Channel Primary Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/continueButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Enter local channel  →"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="@color/resq_primary"
            app:cornerRadius="27dp"
            android:textColor="@color/white"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp" />

    </LinearLayout>
</ScrollView>
