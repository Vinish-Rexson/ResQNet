<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/appbarActionsContainer"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <!-- 1. Mesh Active Badge (First / Leftmost among actions) -->
    <include
        layout="@layout/view_mesh_active_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp" />

    <!-- 2. Tutorial Button (Middle) -->
    <include
        layout="@layout/view_tutorial_appbar_button"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginEnd="4dp" />

    <!-- 3. Logout Button (Last / Rightmost) -->
    <include
        layout="@layout/view_logout_appbar_button"
        android:layout_width="36dp"
        android:layout_height="36dp" />

</LinearLayout>
