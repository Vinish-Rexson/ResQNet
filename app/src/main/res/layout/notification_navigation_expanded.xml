<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- Top Row: Turn Arrow + Maneuver Text + ETA -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Turn Arrow on Left -->
        <ImageView
            android:id="@+id/notifArrow"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_notif_arrow_straight"
            android:contentDescription="Maneuver Arrow" />

        <!-- Maneuver Text & ETA -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="6dp">

            <TextView
                android:id="@+id/notifInstruction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Turn guidance"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/notifEta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Navigating with ResQNet"
                android:textColor="#9AA0A6"
                android:textSize="13sp" />

        </LinearLayout>

        <ImageView
            android:id="@+id/notifIcon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_notif_pin"
            android:visibility="gone"
            android:contentDescription="Navigation" />

    </LinearLayout>

    <!-- Route Progress Bar -->
    <ProgressBar
        android:id="@+id/notifProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/bg_notif_progress_bar" />

    <!-- Exit Navigation Button -->
    <TextView
        android:id="@+id/notifExitButton"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@drawable/bg_notif_exit_button"
        android:gravity="center"
        android:text="Exit navigation"
        android:textColor="#F28B82"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>
