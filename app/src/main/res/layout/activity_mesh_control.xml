<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomNav">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Identity"
                android:textSize="12sp"
                android:textAllCaps="true"
                android:letterSpacing="0.08"
                android:textColor="@color/text_muted" />

            <TextView
                android:id="@+id/identityText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:layout_marginTop="6dp" />

            <TextView
                android:id="@+id/controlStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mesh stopped"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginTop="40dp" />

            <TextView
                android:id="@+id/permissionStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_muted"
                android:textSize="14sp"
                android:layout_marginTop="28dp"
                android:lineSpacingMultiplier="1.4" />

            <Button
                android:id="@+id/permissionButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Grant nearby devices access"
                android:layout_marginTop="10dp"
                app:strokeColor="@color/text_primary"
                android:textColor="@color/text_primary" />

            <Button
                android:id="@+id/startMeshButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Start mesh"
                android:layout_marginTop="32dp" />

            <Button
                android:id="@+id/stopMeshButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Stop mesh"
                android:layout_marginTop="10dp"
                app:strokeColor="@color/text_primary"
                android:textColor="@color/text_primary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mesh mode keeps a visible notification while scanning, advertising, synchronizing history, and forwarding messages."
                android:textColor="@color/text_muted"
                android:textSize="13sp"
                android:lineSpacingMultiplier="1.4"
                android:layout_marginTop="24dp" />

        </LinearLayout>
    </ScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/surface_card"
        app:menu="@menu/bottom_nav_menu"
        app:itemIconTint="@color/bottom_nav_color"
        app:itemTextColor="@color/bottom_nav_color"
        app:elevation="8dp"
        app:labelVisibilityMode="labeled" />

</RelativeLayout>
