<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_rounded"
    android:padding="24dp">

    <!-- Header Icon + Title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_card_rounded"
            android:backgroundTint="@color/palette_amber_subtle"
            android:layout_marginEnd="14dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_shield_status"
                app:tint="@color/palette_amber" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_update_status"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Broadcast your status to circle members"
                android:textSize="12sp"
                android:textColor="@color/text_muted" />
        </LinearLayout>
    </LinearLayout>

    <!-- Status Radio Group -->
    <RadioGroup
        android:id="@+id/statusRadioGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <RadioButton
            android:id="@+id/rbSafe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_safe"
            android:textColor="@color/color_safe"
            android:buttonTint="@color/radio_safe_tint"
            app:buttonTint="@color/radio_safe_tint"
            android:textStyle="bold"
            android:textSize="15sp"
            android:paddingVertical="8dp" />

        <RadioButton
            android:id="@+id/rbNeedHelp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_need_help"
            android:textColor="@color/color_need_help"
            android:buttonTint="@color/radio_need_help_tint"
            app:buttonTint="@color/radio_need_help_tint"
            android:textStyle="bold"
            android:textSize="15sp"
            android:paddingVertical="8dp" />

        <RadioButton
            android:id="@+id/rbUnknown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_unknown"
            android:textColor="@color/color_unknown"
            android:buttonTint="@color/radio_unknown_tint"
            app:buttonTint="@color/radio_unknown_tint"
            android:textStyle="bold"
            android:textSize="15sp"
            android:paddingVertical="8dp" />
    </RadioGroup>

    <!-- Optional Note Input -->
    <EditText
        android:id="@+id/statusNoteInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hint_status_note"
        android:inputType="textCapSentences"
        android:maxLength="140"
        android:background="@drawable/bg_input_box"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:textSize="14sp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_muted"
        android:layout_marginBottom="20dp" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/dialogCancelButton"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="@string/action_cancel"
            android:textColor="@color/text_muted"
            android:textSize="14sp"
            android:layout_marginEnd="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/dialogUpdateButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="Update Status"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/palette_deep_navy"
            app:backgroundTint="@color/palette_amber"
            app:cornerRadius="10dp"
            app:elevation="0dp"
            android:paddingHorizontal="20dp" />
    </LinearLayout>

</LinearLayout>
