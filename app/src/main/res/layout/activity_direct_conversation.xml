<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/surface">

    <!-- AppBar with contact name -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/Theme.ResQNet">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/resq_primary" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Message list -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/dmMessageList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="12dp"
            android:clipToPadding="false" />

        <TextView
            android:id="@+id/dmEmptyState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="32dp"
            android:text="@string/empty_dm"
            android:textColor="@color/text_muted"
            android:textSize="16sp"
            android:lineSpacingMultiplier="1.4"
            android:visibility="gone" />

    </FrameLayout>

    <!-- Input bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp"
        android:background="@color/surface_card"
        android:elevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom">

            <EditText
                android:id="@+id/dmInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/hint_message_dm"
                android:maxLines="4"
                android:inputType="textCapSentences|textMultiLine"
                android:padding="12dp" />

            <Button
                android:id="@+id/dmSendButton"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:text="Send" />

        </LinearLayout>

        <TextView
            android:id="@+id/dmByteCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 / 500 bytes"
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            android:layout_marginStart="12dp" />

    </LinearLayout>

</LinearLayout>
